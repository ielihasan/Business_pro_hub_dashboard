{
  "name": "business-pro-hub",
  "version": "1.0.0",
  "description": "A comprehensive business management platform with landing page and dashboard",
  "private": true,
  "scripts": {
    "dev:landing": "cd landing-page && npm run dev",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build:landing": "cd landing-page && npm run build",
    "build:dashboard": "cd dashboard && npm run build",
    "install:landing": "cd landing-page && npm install",
    "install:dashboard": "cd dashboard && npm install",
    "install:all": "npm run install:landing && npm run install:dashboard"
  },
  "keywords": [
    "business",
    "dashboard",
    "landing-page",
    "nextjs"
  ],
