# ===========================================
# BUSINESS PRO HUB - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.local and fill in your values
# Do NOT commit .env.local to version control

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
# Get these from: Supabase Dashboard → Settings → API
# 1. Create a free account at https://supabase.com
# 2. Create a new project
# 3. Go to Settings → API to find these values

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# APPLICATION CONFIGURATION (REQUIRED)
# ===========================================
# The base URL of your application
# For development: http://localhost:3001
# For production: https://your-domain.com

NEXT_PUBLIC_APP_URL=http://localhost:3002

# ===========================================
# SPRING BOOT BACKEND (REQUIRED)
# ===========================================
# URL of the Spring Boot backend (runs on port 8080 by default)

NEXT_PUBLIC_API_URL=http://localhost:8080

# ===========================================
# EMAIL SERVICE - RESEND (REQUIRED)
# ===========================================
# Get these from: https://resend.com/api-keys
# 1. Sign up for free at https://resend.com
# 2. Create an API key from the dashboard
# 3. For development without custom domain, use: onboarding@resend.dev

RESEND_API_KEY=re_xxxxxxxxx_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=BusinessHub Pro <onboarding@resend.dev>

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Admin email for receiving system notifications
ADMIN_NOTIFICATION_EMAIL=admin@example.com
