# ============================================================
# BusinessHub Pro - Spring Boot Backend Environment Variables
# ============================================================
# Copy this file to .env (same directory) and fill in values.
# NEVER commit .env to version control.
#
# How to get each value:
#   SUPABASE_DB_PASSWORD  → Supabase Dashboard → Settings → Database
#                           (the password you set when creating the project)
#   SUPABASE_SERVICE_ROLE_KEY → Supabase Dashboard → Settings → API
#                               → service_role key (starts with eyJ...)
#   SUPABASE_JWT_SECRET   → Supabase Dashboard → Settings → API → JWT Secret
#   RESEND_API_KEY        → https://resend.com/api-keys
#   ADMIN_NOTIFICATION_EMAIL → any email address for admin alerts
# ============================================================

SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
RESEND_API_KEY=re_xxxxxxxxx_xxxxxxxxxxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=admin@example.com
